{
  "name": "tahcia",
  "displayName": "Tahcia",
  "description": "Tahcia script download & upload gateway",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWorkspaceContains:tahcia-config.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tahcia.init",
        "title": "Init Tahcia Here"
      },
      {
        "command": "tahcia.upload",
        "title": "Upload Script to Tahcia"
      },
      {
        "command": "tahcia.download",
        "title": "Download Script from Tahcia"
      },
      {
        "command": "tahcia.browse",
        "title": "Browse Remote Scripts"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "tahcia.init",
          "when": "explorerResourceIsFolder && !(resourcePath in tahcia.configDirs)",
          "group": "tahcia-group@1"
        },
        {
          "command": "tahcia.browse",
          "when": "explorerResourceIsFolder && resourcePath in tahcia.supportedDirs",
          "group": "tahcia-group@2"
        },
        {
          "command": "tahcia.upload",
          "when": "resourceFilename =~ /\\.tahcia\\.json$/ && !explorerResourceIsFolder && resourcePath in tahcia.supportedPaths",
          "group": "tahcia-group@3"
        },
        {
          "command": "tahcia.download",
          "when": "resourceFilename =~ /\\.tahcia\\.json$/ && !explorerResourceIsFolder && resourcePath in tahcia.supportedPaths",
          "group": "tahcia-group@4"
        }
      ],
      "editor/context": [
        {
          "command": "tahcia.upload",
          "when": "resourceFilename =~ /\\.tahcia\\.json$/ && resourcePath in tahcia.supportedPaths",
          "group": "tahcia-group@1"
        },
        {
          "command": "tahcia.download",
          "when": "resourceFilename =~ /\\.tahcia\\.json$/ && resourcePath in tahcia.supportedPaths",
          "group": "tahcia-group@2"
        },
        {
          "command": "tahcia.browse",
          "when": "resourceDirname in tahcia.supportedDirs",
          "group": "tahcia-group@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}